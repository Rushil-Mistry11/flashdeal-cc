# Copy to .env  (cp .env.example .env). .env is git-ignored.
AWS_REGION=us-east-1
SQS_QUEUE_NAME=flashdeal-claims

# ---- ONLY for docker-compose.local.yml (laptop). On EC2 leave these out: the instance profile provides credentials. ----
# Learner Lab > AWS Details > "AWS CLI: Show". They change every session.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- Optional knobs (defaults shown) ----
# RATE_LIMIT_CAPACITY=10
# RATE_LIMIT_REFILL_PER_SEC=5
# PROCESSING_MS_MIN=150
# PROCESSING_MS_MAX=400
# FAIL_RATE=0
